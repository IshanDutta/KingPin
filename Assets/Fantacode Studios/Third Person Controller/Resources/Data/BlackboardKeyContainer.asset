    name: TargetVehicle
    type: 6
    description: The vehicle the AI is heading for or chasing.
  - id: 0862c577-129c-4d7a-bc40-8d1d885eeaab
    name: TargetSeat
    type: 6
    description: The seat it means to take. Unset means any free seat on the target
      vehicle.
  - id: a0ae7d3c-812d-46e8-b41e-8f72e266c3af
    name: CurrentVehicle
    type: 6
    description: The vehicle it is actually aboard. Set once seated, cleared once
      out.
  - id: 4f7b0e4e-fc5e-4b18-95ce-c3c91f6bf574
    name: CurrentSeat
    type: 6
    description: The seat it actually occupies. Set once seated, cleared once out.
  - id: 5fbb4341-c0eb-43c4-99e2-5e2defed448c
    name: VehicleWaypoints
    type: 6
    description: Root of the waypoint network handed to the vehicle's own AI driver.
  - id: fb70b416-b6c0-44b8-8f21-4d9e69992324
    name: EnterVehicle
    type: 1
    description: 'Order: get into the target vehicle.'
  - id: b5407297-09cc-42a9-8167-eca5ea4f4f56
    name: ExitVehicle
    type: 1
    description: 'Order: get out of the current vehicle. Cleared by Exit Vehicle
      once carried out.'
  - id: 3d3309dc-8c96-4f4d-917f-a80996fc3d66
    name: DriveVehicle
    type: 1
    description: 'Order: drive the vehicle this character is at the wheel of.'
  - id: 54ea0a39-b085-4e9f-b697-da3fae41a172
    name: ChaseVehicleToEnter
    type: 1
    description: 'Order: run after the target vehicle to get back into it.'
  - id: 6a9eb88e-6aee-4027-8a8f-df9ab14743fb
    name: IsInVehicle
    type: 1
    description: Aboard a vehicle, driver or passenger.
  - id: 781344d4-65c1-4093-b2c2-6961e0fa7bd8
    name: IsDriving
    type: 1
    description: At the wheel with the engine running. A passenger is IsInVehicle
      but not this.
  - id: 7be314f7-0d4a-4cac-a1fe-5edca1f96a78
    name: WasPulledFromVehicle
    type: 1
    description: Another character hauled this AI out of its seat.
  - id: e186c6e7-82fc-4b98-ae2c-615a0bdda847
    name: VehicleEntryFailed
    type: 1
    description: A boarding attempt ended without seating the character.
  - id: b1f7ecb8-ce8b-46ac-85ee-2a4fdc303d29
    name: VehicleChaseGaveUp
    type: 1
    description: A chase ran out of time or distance without catching the vehicle.
  - id: 2c53cf1d-f884-4ea5-8517-90dcb66a2224
    name: DistanceToVehicle
    type: 0
    description: Distance to the target vehicle, refreshed every tick while chasing.
  - id: b490864a-6ac9-4446-9746-207d5439cb23
    name: VehicleChaseSpeed
    type: 0
    description: Overrides the chase speed authored on the state. Ignored when not
      positive.
  - id: aa10d304-d128-4df6-94ba-1e06be8b52e9
    name: VehicleChaseTimeout
    type: 0
    description: Overrides the chase timeout authored on the state. Ignored when
      not positive.
  - id: ea251553-ad02-451e-b641-ffc0a407c753
    name: VehicleChaseMaxDistance
    type: 0
    description: Overrides the chase give-up distance authored on the state. Ignored
      when not positive.
  - id: bf36f55a-63d1-463f-86c1-7788e9f4884d
    name: VehicleDestination
    type: 5
    description: Where to drive to when no waypoint network is used.
  - id: aa5da80e-af17-4791-83cd-4de9303f1bc5
    name: LoopVehicleWaypoints
    type: 1
    description: Whether the vehicle's AI driver loops its waypoint route.
